From: ios-sweet Windows/QEMU port
Subject: [PATCH] sweet: QEMU virtual input (touch, buttons, keyboard) + no RTC wait

QEMU has none of the phone's touch (Goodix over GENI) or key (PMIC) hardware.
With boot-arg sweetvinput=1 a kernel thread polls the QEMU virt PL011 UART
(0x09000000) for one-line text commands from the host launcher and feeds
SweetHIDTouch, SweetHIDButtons and a new SweetHIDKeyboard (HID page 7):
  T <finger> <down> <x> <y> | B <key> <down> | K <usage> <down>
Without the boot-arg nothing changes (the keyboard service does not start).

IOKitInitializeTime waited 30 s for an IORTC that neither the phone port nor
QEMU publishes: skip it on SWEET like Apple does on BCM2837.

--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -78,7 +78,8 @@ IOKitInitializeTime( void )
 	t.tv_nsec = 0;
 
 // RTC is not present on this target
-#ifndef BCM2837
+// (SWEET: neither the phone port nor QEMU publishes an IORTC: skip the 30 s wait)
+#if !defined(BCM2837) && !defined(ARM64_BOARD_CONFIG_SWEET)
 	IOService::waitForService(
 		IOService::resourceMatching("IORTC"), &t );
 #endif
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -11,14 +11,21 @@
  *
  *   SweetHIDButtons  consumer-control keys (power, volume, home)
  *   SweetHIDTouch    the built-in touch screen (digitizer collections)
+ *   SweetHIDKeyboard a hardware keyboard (QEMU only, boot-arg sweetvinput=1)
  *
  * Hardware drivers feed them through the C entry points sweet_hid_key()
  * and sweet_hid_touch(). Boot-arg sweethidtest=N (seconds) presses Home
  * every N seconds, to test the event path without input hardware.
+ *
+ * On QEMU (boot-arg sweetvinput=1) the phone's touch and key hardware is
+ * absent: sweet_vinput_start() polls the QEMU virt PL011 UART for text
+ * commands from the host launcher and feeds the same services.
  */
 #include <IOKit/IOLib.h>
 #include <IOKit/IOService.h>
 #include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <kern/thread.h>
 #include <libkern/c++/OSArray.h>
 #include <pexpert/pexpert.h>
 
@@ -375,8 +382,22 @@ private:
 };
 OSDefineMetaClassAndStructors(SweetHIDTouch, IOHIDEventService);
 
+class SweetHIDKeyboard : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDKeyboard);
+public:
