 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
+static SweetHIDKeyboard *gSweetKeyboard;
+static void sweet_vinput_start(void);
 
 bool
 SweetHIDButtons::start(IOService *provider)
@@ -445,6 +466,7 @@ SweetHIDTouch::start(IOService *provider)
 	gSweetTouch = this;
 	registerService();
 	IOLog("SWEET HID: touch registered\n");
