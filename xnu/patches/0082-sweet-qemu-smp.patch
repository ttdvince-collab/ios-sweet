From: ios-sweet Windows/QEMU port
Subject: [PATCH] sweet: SMP on QEMU virt (flat MPIDRs, PSCI over HVC)

QEMU virt numbers cores in MPIDR Aff0 (0-7) and, without EL2/EL3,
emulates PSCI over HVC. Accept Aff0 topologies next to the phone's Aff1
one and pick the conduit with boot-arg sweethvc=1. No phone change.

--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -25,6 +25,12 @@ class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
 static uint32_t sweet_cpus_registered;
 
+/*
+ * PSCI conduit: SMC on the phone (TrustZone firmware). QEMU virt without EL2/EL3
+ * emulates PSCI over HVC instead: boot-arg sweethvc=1 selects it.
+ */
+static uint32_t sweet_psci_hvc;
+
 /* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
 static int32_t
 sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
@@ -33,9 +39,15 @@ sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
 	register uint64_t x1 __asm__("x1") = target;
 	register uint64_t x2 __asm__("x2") = entry;
 	register uint64_t x3 __asm__("x3") = context;
-	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
-	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
-	    "x14", "x15", "x16", "x17", "cc", "memory");
+	if (sweet_psci_hvc) {
+		__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	} else {
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	}
 	return (int32_t)x0;
 }
 
@@ -73,9 +85,14 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
-	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
-	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+	/*
+	 * Phone: MPIDR Aff1 = core (0x000-0x500 A55, 0x600/0x700 A76).
+	 * QEMU virt: MPIDR Aff0 = core (0-7). Everything downstream (reset vector,
+	 * SGI targets, GICR lookup) uses the full Aff1:Aff0 value, so both work.
+	 */
+	bool phone_mpidr = cpu->phys_id <= 0x700 && (cpu->phys_id & 0xff) == 0;
+	bool flat_mpidr = cpu->phys_id < 8;
+	if (!(phone_mpidr || flat_mpidr) || topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
@@ -128,6 +145,10 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	const ml_topology_info_t *topology = ml_get_topology_info();
 	uint32_t requested = 1;
 	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
+	PE_parse_boot_argn("sweethvc", &sweet_psci_hvc, sizeof(sweet_psci_hvc));
+	if (sweet_psci_hvc) {
+		IOLog("SWEET CPU: PSCI over HVC (sweethvc=1)\n");
+	}
 	IOLog("SWEET CPU: requested=%u selected=%u (limit=%u)\n",
 	    requested, topology->num_cpus, SWEET_SMP_MAX_CPUS);
 
